# Claude Code Sandbox Container Image
# This image provides the sandbox runtime environment for Claude Code in containerized deployments
#
# Build: docker build -f docker/Dockerfile.sandbox -t ccr.ccs.tencentyun.com/patent/claude-code-sandbox:latest .
# Run:   docker run -d --name claude-sandbox claude-code-sandbox:latest
# Build with custom base: docker build --build-arg BASE_IMAGE=myregistry/base:latest -f docker/Dockerfile.sandbox ...

# Base image which contains all Node.js dependencies
# Use --build-arg to override the default
ARG BASE_IMAGE=claude-code-ui:base
FROM ${BASE_IMAGE}

# Switch to root user for setup
USER root

# Install runtime dependencies (build tools already in base image)
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    bash \
    jq \
    python3 \
    python3-pip \
    vim-tiny \
    poppler-utils \
    pandoc \
    texlive-xetex \
    texlive-fonts-recommended \
    texlive-lang-chinese \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# 预装 patent skills 所需的 Python 依赖（PCT DOCX 转换工具包 / 专利申请 DOCX 组装）
# - lxml==6.0.0 是 python-docx 的底层 XML 依赖，锁定版本保证每个容器环境一致可复现、不自动升级
# - python-docx>=1.1 是 PCT 转换(v2.2.0)与申请文件组装工具包的显式依赖（顺带补 assembly skill 缺口）
# ⚠️ 版本约束必须加引号：未加引号时 shell(/bin/sh -c) 会把 '>=10' 解析为输出重定向
# （> =10），在 WORKDIR(/workspace) 下生成名为 =10 的垃圾文件，进而被项目发现误识别为项目，
# 导致 SDK chdir 到文件路径报 spawn ENOTDIR。
# ⚠️ 使用清华 PyPI 镜像：腾讯云访问 files.pythonhosted.org 速度极慢（~10 kB/s），
# 不加镜像会导致 Pillow 6.9 MB 下载超时失败（ReadTimeoutError）。
RUN pip3 install --no-cache-dir --break-system-packages \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    'Pillow>=10' 'lxml==6.0.0' 'python-docx>=1.1'

# 预装 patent-docx-collaborative-review 技能所需的 OfficeCLI（原生处理 WordprocessingML 批注与修订痕迹）
# 锁定技能已验证版本 1.0.132；全局装进系统 PATH，技能脚本按 OFFICECLI env → node_modules/.bin → PATH 查找
# OfficeCLI 的 vendor 原生二进制不在 npm 包里，由 postinstall(install.js → install-binary.js)
# 从 d.officecli.ai/GitHub releases 下载（pinned v1.0.132）。二进制内嵌 self-updater，运行时会自动替换
# vendor/officecli 导致漂移到 1.0.14x + .NET 程序集缓存失效（System.IO.Pipelines 找不到），
# 故下载成功后 chmod 555 锁定（只读+可执行，防 self-updater 原地替换）。
# 注意1：用 555（r-xr-xr-x）而非 444——444 去掉执行位会导致 EACCES、pct_selftest 失败、PCT 被自检门控卡死。
# 注意2：生产要求确定性——vendor 二进制必须在 build 阶段就下好，不依赖运行时 lazy 下载
#   （不可控，且失去 555 锁的漂移防护）。postinstall 下载失败是 non-fatal（install.js exit 0），
#   故下面显式再调 ensureBinary 并用 test -f 门控：下载失败则 build 直接 fail，把网络问题在
#   build 阶段暴露出来。若 build 环境访问不了 d.officecli.ai/GitHub，用 `docker build --network=host`
#   走宿主网络（旧容器运行时下到过 1.0.142，证明宿主可达该源）。
RUN npm install -g @officecli/officecli@1.0.132 && \
    PKG=/usr/local/lib/node_modules/@officecli/officecli && \                                                                                                         
    node -e "require('$PKG/lib/install-binary.js').ensureBinary().catch(e=>{console.error('[officecli] '+e.message);process.exit(1)})" && \                           
    test -f "$PKG/vendor/officecli" && \                                                                                                                              
    chmod 555 "$PKG/vendor/officecli"    
# Create workspace and config directories
RUN mkdir -p /workspace /app /workspace/.claude/projects && \
    chown -R node:node /workspace /app

# Copy application files to /app directory
COPY --chown=node:node backend /app/backend
COPY --chown=node:node shared /app/shared
COPY --chown=node:node extensions/.claude /app/extensions/.claude

# Install gosu for user switching
RUN apt-get update && apt-get install -y gosu && rm -rf /var/lib/apt/lists/*

# Copy entrypoint script
COPY docker/entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Set working directory
WORKDIR /workspace

# Set environment variables
ENV NODE_ENV=production \
    CLAUDE_CONFIG_DIR=/workspace/my-workspace/.claude \
    NODE_PATH=/app/node_modules

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD pgrep -f "node.*container-entrypoint.js" >/dev/null || exit 1

# Use entrypoint to fix permissions before switching to node user
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Container entrypoint - keeps container running
CMD ["node", "/app/backend/container-entrypoint.js"]
